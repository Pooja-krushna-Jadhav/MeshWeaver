# MeshWeaver Edge Node Configuration Example
# Copy this file to .env and adjust variables as needed for your edge device.
# (Note: .env is ignored by Git to protect cluster secrets)

# Node Identity & Network
MESHWEAVER_NODE_NAME=edge-node-01
MESHWEAVER_HOST=0.0.0.0
MESHWEAVER_TCP_PORT=8765
MESHWEAVER_UDP_PORT=8766

# Cluster Discovery
# Comma-separated list of bootstrap peers (IP:PORT or HOSTNAME:PORT)
MESHWEAVER_BOOTSTRAP_PEERS=192.168.1.10:8765,192.168.1.11:8765

# Security & Authentication
# Cluster-wide shared secret for HMAC-SHA256 message signing (minimum 16 characters recommended)
MESHWEAVER_SECRET=replace_with_a_secure_cluster_secret_phrase

# Local State Persistence
MESHWEAVER_DB_PATH=meshweaver_state.db

# Diagnostics
MESHWEAVER_LOG_LEVEL=INFO
